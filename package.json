{
  "name": "flutter-learning-react",
  "homepage": "https://daronec.github.io",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "migrate:content": "node scripts/migrate-content.mjs",
